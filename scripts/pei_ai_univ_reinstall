#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: bash scripts/reinstall-skills.sh [-full|-normal|-small|-part_myskill]

  -full           Install all configured repositories (default).
  -normal         Skip vercel-labs/agent-skills.
  -small          Install all skills from ShengLin1001/codex-config only.
  -part_myskill   Install ShengLin1001/codex-config except selected management skills.
  -h, --help      Show this help.
EOF
}

mode="${1:--full}"
if [ "$#" -gt 1 ]; then
  usage >&2
  exit 2
fi

repo_myskill="https://github.com/ShengLin1001/codex-config.git"
lnormal_repos=(
  "vercel-labs/skills"
  "$repo_myskill"
  "https://github.com/Imbad0202/academic-research-skills-codex.git"
  "https://github.com/Yuan1z0825/nature-skills.git"
)

case "$mode" in
  -full)
    lrepos=("vercel-labs/agent-skills" "${lnormal_repos[@]}")
    ;;
  -normal)
    lrepos=("${lnormal_repos[@]}")
    ;;
  -small|-part_myskill)
    lrepos=("$repo_myskill")
    ;;
  -h|--help)
    usage
    exit 0
    ;;
  *)
    echo "Unknown installation strategy: $mode" >&2
    usage >&2
    exit 2
    ;;
esac

lselected_skills=('*')
if [ "$mode" = "-part_myskill" ]; then
  path_script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
  path_repo_root="$(cd -- "$path_script_dir/.." && pwd)"
  lexcluded_skills=(
    "p-skill-installer"
    "p-skill-creator"
    "p-plugin-installer"
    "p-pdf2zotero"
    "p-pdf-download"
    "p-page-creator"
  )
  lselected_skills=()

  for path_skill in "$path_repo_root"/skills/*; do
    [ -f "$path_skill/SKILL.md" ] || continue
    skill="${path_skill##*/}"
    case " ${lexcluded_skills[*]} " in
      *" $skill "*) ;;
      *) lselected_skills+=("$skill") ;;
    esac
  done

  if [ "${#lselected_skills[@]}" -eq 0 ]; then
    echo "No skills remain after applying -part_myskill exclusions." >&2
    exit 1
  fi
fi

# Agents to install skills into (space-separated).
# Defaults to both Codex and Claude Code. Override examples:
#   AGENTS="claude-code" bash scripts/reinstall-skills.sh   # only Claude Code
#   AGENTS="codex"       bash scripts/reinstall-skills.sh   # only Codex
#   AGENTS="*"           bash scripts/reinstall-skills.sh   # all detected agents
# Backward compat: the old single-agent AGENT variable is still honored.
AGENTS="${AGENTS:-${AGENT:-codex claude-code}}"
GLOBAL_FLAG="${GLOBAL_FLAG:--g}"
read -r -a AGENT_LIST <<< "$AGENTS"

# Avoid GitHub's 60 req/hr anonymous API rate limit (causes "Failed to update"):
# reuse the gh login token when GITHUB_TOKEN isn't already set.
if [ -z "${GITHUB_TOKEN:-}" ] && command -v gh >/dev/null 2>&1; then
  GITHUB_TOKEN="$(gh auth token 2>/dev/null || true)"
  export GITHUB_TOKEN
fi

if ! command -v npx >/dev/null 2>&1; then
  if command -v module >/dev/null 2>&1; then
    module avail node 2>&1 || true
  fi
  echo "npx was not found. Load or install Node.js/npm first, then rerun." >&2
  exit 127
fi

npx --yes skills remove --all "$GLOBAL_FLAG"

for repo in "${lrepos[@]}"; do
  # Install once per repo; the CLI links the same global skill set to both agents.
  npx --yes skills add "$repo" "$GLOBAL_FLAG" --agent "${AGENT_LIST[@]}" --skill "${lselected_skills[@]}" --yes
done

for agent in "${AGENT_LIST[@]}"; do
  npx --yes skills list "$GLOBAL_FLAG" --agent "$agent"
done

# Update existing skills to their latest versions (needs node > 18):
# npx --yes skills update -g -y

# Remove all global skills:
# npx --yes skills remove --all -g
