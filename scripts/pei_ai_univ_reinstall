#!/usr/bin/env bash
#
# 重装 skills。唯一来源是本仓库的 skills-using/，不从别的仓库装。
# 默认装进当前目录这个项目，加 -global 才装成用户级。
#
#   skills-using/root/              跨项目通用，-root 安装这一层
#   skills-using/project/<域>/      按项目类型加载，-project <域>... 安装
#
# 仓库里其他目录（skills/、skills-generating/、skills-bak/）一律不装。
#
# 布局是硬约束：npx skills add 只对「skill 位于仓库子目录」的布局拷贝完整目录。
# 仓库根目录直接放 SKILL.md 的话，它只装走 SKILL.md，scripts/ 一个不带。
#
set -euo pipefail

path_script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
path_repo_root="$(cd -- "$path_script_dir/.." && pwd)"

repo="ShengLin1001/codex-config"
dir_root="skills-using/root"
dir_project="skills-using/project"

usage() {
  cat <<EOF
Usage: pei_ai_univ_reinstall [-global] [-root] [-project <域>...] [-clean] [-list] [-dry_run]

选装哪些 skill：
  -root              安装 $dir_root/ 下的全部 skill
  -project <域>...   安装 $dir_project/<域>/ 下的全部 skill，可给多个域

装到哪里：
  -global            装成用户级（~/.agents/skills，所有项目可见）
  （不给 -global）    装进当前目录这个项目（./.claude/skills 等），只对它生效

其他：
  -clean             安装前先移除该范围内已装的 skill
  -list              只列出会安装什么，不执行
  -dry_run           打印将要执行的 npx 命令，不执行
  -h, --help         显示本帮助

可用的项目域：$(ls "$path_repo_root/$dir_project" 2>/dev/null | tr '\n' ' ')

示例：
  pei_ai_univ_reinstall -global -root                    # 用户级装通用 skill
  pei_ai_univ_reinstall -global -root -project academic python
  cd <项目根> && pei_ai_univ_reinstall -root -project python   # 只装进这个项目
  cd <项目根> && pei_ai_univ_reinstall -clean -root
  AGENTS="codex" pei_ai_univ_reinstall -global -root

注意 -project 和 -global 是两个不相干的维度：-project 选"装哪些"，
-global 选"装到哪"。项目级安装认的是**当前工作目录**，不是 -project 后面那个域名。

环境变量：
  AGENTS   目标 agent，空格分隔（默认 "codex claude-code openclaw hermes-agent"）
EOF
}

# --- 参数 ---------------------------------------------------------------
want_root=false
want_global=false
clean=false
list_only=false
dry_run=false
lproject=()
mode=""          # 读到 -project 后，后续裸参数都归给它

for arg in "$@"; do
  case "$arg" in
    -root)            want_root=true; mode="" ;;
    -project)         mode="project" ;;
    -global)          want_global=true; mode="" ;;
    -clean)           clean=true; mode="" ;;
    -list)            list_only=true; mode="" ;;
    -dry_run)         dry_run=true; mode="" ;;
    -h|--help)        usage; exit 0 ;;
    -*)               echo "未知参数: $arg" >&2; usage >&2; exit 2 ;;
    *)
      if [ "$mode" = "project" ]; then
        lproject+=("$arg")
      else
        echo "多余的参数: $arg（项目域要跟在 -project 后面）" >&2
        exit 2
      fi
      ;;
  esac
done

if [ "$want_root" = false ] && [ "${#lproject[@]}" -eq 0 ]; then
  echo "什么都没选。至少给一个 -root 或 -project <域>。" >&2
  usage >&2
  exit 2
fi

# --- 收集 skill 名 ------------------------------------------------------
# 名字取自含 SKILL.md 的目录名。project 下还有 explicit/ implicit/ 一层，
# 所以按 SKILL.md 找而不是按固定深度猜。
collect() {   # collect <相对仓库根的目录>
  local path_base="$path_repo_root/$1"
  [ -d "$path_base" ] || { echo "找不到 $1" >&2; return 1; }
  find "$path_base" -name SKILL.md -print | while read -r path_skill_md; do
    basename "$(dirname "$path_skill_md")"
  done | sort -u
}

lskill=()
if [ "$want_root" = true ]; then
  while read -r skill; do [ -n "$skill" ] && lskill+=("$skill"); done < <(collect "$dir_root")
fi
for domain in "${lproject[@]:-}"; do
  [ -n "$domain" ] || continue
  if [ ! -d "$path_repo_root/$dir_project/$domain" ]; then
    echo "没有这个项目域: $domain" >&2
    echo "可用: $(ls "$path_repo_root/$dir_project" | tr '\n' ' ')" >&2
    exit 2
  fi
  while read -r skill; do [ -n "$skill" ] && lskill+=("$skill"); done < <(collect "$dir_project/$domain")
done

if [ "${#lskill[@]}" -eq 0 ]; then
  echo "选中的目录里没有找到任何 SKILL.md。" >&2
  exit 1
fi

echo "将安装 ${#lskill[@]} 个 skill:"
printf '  %s\n' "${lskill[@]}"
[ "$list_only" = true ] && exit 0

# --- 环境 ---------------------------------------------------------------
AGENTS="${AGENTS:-codex claude-code openclaw hermes-agent}"
read -r -a lagent <<< "$AGENTS"

# -g / -p 是 npx skills 自己的开关，属于外部命名空间，原样用。
if [ "$want_global" = true ]; then
  scope_flag="-g"
  echo "装到：用户级（所有项目可见）"
else
  scope_flag="-p"
  echo "装到：当前项目 $(pwd)（要装成用户级请加 -global）"
fi

# 走 GitHub API 时匿名只有 60 次/小时，用完会报 "Failed to update"。
if [ -z "${GITHUB_TOKEN:-}" ] && command -v gh >/dev/null 2>&1; then
  GITHUB_TOKEN="$(gh auth token 2>/dev/null || true)"
  export GITHUB_TOKEN
fi
# 当前 Node 需要显式读代理环境变量，否则访问 GitHub 会卡住。
export NODE_OPTIONS="${NODE_OPTIONS:---use-env-proxy}"

if ! command -v npx >/dev/null 2>&1; then
  command -v module >/dev/null 2>&1 && module avail node 2>&1 || true
  echo "找不到 npx。先装好 Node.js/npm 再跑。" >&2
  exit 127
fi

run() {
  if [ "$dry_run" = true ]; then printf '  [dry-run] %q' "$1"; shift; printf ' %q' "$@"; printf '\n'
  else "$@"; fi
}

# --- 执行 ---------------------------------------------------------------
if [ "$clean" = true ]; then
  echo "先移除该范围内已装的 skill…"
  run npx --yes skills remove --all "$scope_flag"
fi

echo "从 $repo 安装…"
run npx --yes skills add "$repo" "$scope_flag" \
    --agent "${lagent[@]}" --skill "${lskill[@]}" --yes

for agent in "${lagent[@]}"; do
  run npx --yes skills list "$scope_flag" --agent "$agent"
done
